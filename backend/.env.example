# DisputePro backend config. Never commit this file.

# AI agents: OpenAI Codex on our ChatGPT plan. No key needed: the Codex CLI login (`codex login`) is used.
LLM_PROVIDER=codex
# Building/testing: cheap and fast. Before deploying for judges switch to CODEX_MODEL=gpt-6.1-sol, CODEX_REASONING_EFFORT=medium
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low

# neatlogs project API key (app.neatlogs.com -> setup -> CLI tab -> project API key)
# neatlogs org/project ids (from the dashboard URL; not secret) to link runs to traces
NEATLOGS_ORG_ID=
NEATLOGS_PROJECT_ID=
NEATLOGS_API_KEY=

# Crustdata API key (not used by the agents; kept for go-to-market research)
CRUSTDATA_API_KEY=

# Execution guardrail: payouts above this (paise) need human approval
AUTO_APPROVE_LIMIT_PAISE=1000000

# Public deployment: ration our ChatGPT plan across visitors (rules-mode runs are not limited)
RUNS_PER_VISITOR_PER_HOUR=6
MAX_CONCURRENT_LLM_RUNS=2

# DisputePro MCP bearer token (cfo.ai -> Connections -> MCP -> Add manually; also used by Claude Code)
MCP_API_TOKEN=
