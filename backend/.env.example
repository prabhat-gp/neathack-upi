# ---------------------------------------------------------------------------
# DisputePro backend config. Copy to backend/.env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Agent brain. auto = codex if the Codex CLI is signed in with ChatGPT, else bedrock/anthropic keys, else rules.
LLM_PROVIDER=codex

# 1) OpenAI Codex on your ChatGPT plan. No key here: run `codex login` once (Sign in with ChatGPT).
#    The login lives in ~/.codex/auth.json and is used by every agent run.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=low

# 2) AWS Bedrock (not available on the neatHack AWS account)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# 3) Anthropic API key (not used for the submission)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# neatlogs project API key (app.neatlogs.com -> setup -> "send your first trace")
NEATLOGS_API_KEY=

# Crustdata API key (app.crustdata.com -> Developer -> API Keys). Used live by the Investigator via MCP.
CRUSTDATA_API_KEY=

# Counterparty adapters. Defaults to the bundled sandbox on this server.
# PARTY_BASE_URL=http://127.0.0.1:8000/sandbox

AUTO_APPROVE_LIMIT_PAISE=1000000

# Public deployment: ration our ChatGPT plan across visitors (rules-mode runs are not limited)
RUNS_PER_VISITOR_PER_HOUR=6
MAX_CONCURRENT_LLM_RUNS=2
