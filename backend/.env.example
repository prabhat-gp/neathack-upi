# ---------------------------------------------------------------------------
# DisputePro backend config. Copy to backend/.env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Agent brain: auto picks the first one with credentials:
#   claude-code (CLAUDE_CODE_OAUTH_TOKEN) -> bedrock -> anthropic -> rules
LLM_PROVIDER=auto

# 1) Claude via Claude Code token (Claude Agent SDK). Get it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL=claude-sonnet-5-5

# 2) AWS Bedrock (only if your AWS account has Bedrock model access in us-east-1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# 3) Or the Anthropic API directly
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# neatlogs project API key (app.neatlogs.com -> setup -> "send your first trace")
NEATLOGS_API_KEY=

# Crustdata API key (app.crustdata.com -> Developer -> API Keys). Used live by the Investigator via MCP.
CRUSTDATA_API_KEY=

# Counterparty adapters. Defaults to the bundled sandbox on this server.
# PARTY_BASE_URL=http://127.0.0.1:8000/sandbox

AUTO_APPROVE_LIMIT_PAISE=1000000
